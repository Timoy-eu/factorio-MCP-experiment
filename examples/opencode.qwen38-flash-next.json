{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/qwen38-flash-next",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen38-flash-next": {
          "name": "Qwen3.8 Flash-Next (local)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "factorio": {
      "type": "local",
      "command": [
        "/home/YOU/factorio-agent-mcp/.venv/bin/factorio-agent-mcp"
      ],
      "environment": {
        "FACTORIO_RCON_HOST": "127.0.0.1",
        "FACTORIO_RCON_PORT": "27015",
        "FACTORIO_RCON_PASSWORD": "secret",
        "FACTORIO_MCP_DATA_DIR": "/home/YOU/factorio-agent-data",
        "FACTORIO_MCP_RENDER_DIR": "/home/YOU/factorio-agent-data/renders",
        "FACTORIO_MCP_PROFILE": "core"
      },
      "enabled": true,
      "timeout": 15000
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}
